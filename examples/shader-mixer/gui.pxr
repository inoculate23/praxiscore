@ /gui root:gui {
 @ ./deck-a-preset gui:combobox { .label "Deck A / preset"; .binding /video/deck-a.preset; .layout "cell 0 0, growx, width 280:340:, height 44!" }
 @ ./deck-a-speed gui:h-slider { .label "Deck A / speed"; .binding /video/deck-a.speed; .layout "cell 0 1, growx, width 280:340:, height 44!" }
 @ ./deck-a-zoom gui:h-slider { .label "Deck A / zoom"; .binding /video/deck-a.zoom; .layout "cell 0 2, growx, width 280:340:, height 44!" }
 @ ./deck-a-reaction gui:h-slider { .label "Deck A / reaction"; .binding /video/deck-a.reaction; .layout "cell 0 3, growx, width 280:340:, height 44!" }
 @ ./deck-a-freeze gui:togglebutton { .label "Deck A / freeze"; .binding /video/deck-a.freeze; .layout "cell 0 4, growx, width 280:340:, height 44!" }
 @ ./deck-b-preset gui:combobox { .label "Deck B / preset"; .binding /video/deck-b.preset; .layout "cell 1 0, growx, width 280:340:, height 44!" }
 @ ./deck-b-speed gui:h-slider { .label "Deck B / speed"; .binding /video/deck-b.speed; .layout "cell 1 1, growx, width 280:340:, height 44!" }
 @ ./deck-b-zoom gui:h-slider { .label "Deck B / zoom"; .binding /video/deck-b.zoom; .layout "cell 1 2, growx, width 280:340:, height 44!" }
 @ ./deck-b-reaction gui:h-slider { .label "Deck B / reaction"; .binding /video/deck-b.reaction; .layout "cell 1 3, growx, width 280:340:, height 44!" }
 @ ./deck-b-freeze gui:togglebutton { .label "Deck B / freeze"; .binding /video/deck-b.freeze; .layout "cell 1 4, growx, width 280:340:, height 44!" }
 @ ./crossfade gui:h-slider { .label "Crossfade A -> B"; .binding /video/control.crossfade; .layout "cell 0 6 2 1, growx, height 42!" }
 @ ./audio-mix gui:h-slider { .label "Audio crossfade depth"; .binding /video/control.audio-mix; .layout "cell 0 7 2 1, growx, height 42!" }
 @ ./sensitivity gui:h-slider { .label "Audio sensitivity"; .binding /video/control.sensitivity; .layout "cell 0 8 2 1, growx, height 42!" }
 @ ./brightness gui:h-slider { .label "Master brightness"; .binding /video/control.brightness; .layout "cell 0 9 2 1, growx, height 42!" }
 @ ./demo gui:togglebutton { .label "Demo pulse (no microphone)"; .binding /video/control.demo; .layout "cell 0 10 2 1, growx, height 42!" }
 @ ./blackout gui:togglebutton { .label "BLACKOUT"; .binding /video/control.blackout; .layout "cell 0 11 2 1, growx, height 42!" }
 @ ./blend gui:combobox { .label "Blend mode"; .binding /video/mix.mode; .layout "cell 0 12 2 1, growx, height 42!" }
}
