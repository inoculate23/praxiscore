@ /video root:video {
  .width 4096
  .height 4096
  .fps 60
  @ ./dome video:custom {
    .code "// Equidistant 180-degree fulldome: center = zenith, circumference = horizon.\n@P(1) @Type.Number(min=0, max=1) double energy;\n@P(2) @Type.Number(min=0.1, max=30, def=8) double sensitivity;\n@P(3) @Type.Number(min=0, max=3, def=0.35) double speed;\n@P(4) @Type.Number(min=0, max=1, def=0.8) double brightness;\n\ndouble envelope;\ndouble previousTime;\ndouble phase;\n\n@Override\npublic void draw() {\n    double now = millis() / 1000.0;\n    double dt = previousTime == 0 ? 1.0 / 60 : Math.max(0, Math.min(0.1, now - previousTime));\n    previousTime = now;\n    double target = Math.min(1, Math.max(0, energy * sensitivity));\n    // Fast attack, slow release; continuous motion when the input is silent.\n    envelope += (target - envelope) * (1 - Math.exp(-dt / (target > envelope ? 0.045 : 0.3)));\n    phase += dt * speed * (0.5 + envelope * 1.5);\n    background(0);\n    double radius = Math.min(width, height) * 0.485;\n    double cx = width * 0.5;\n    double cy = height * 0.5;\n    double e = envelope;\n    noFill();\n    strokeWeight(Math.max(1, width / 900.0));\n    // Latitude rings and azimuth spokes form a hemispherical wave field.\n    for (int ring = 1; ring <= 18; ring++) {\n        double theta = ring / 18.0 * Math.PI / 2;\n        stroke(28 * brightness, (100 + 100 * e) * brightness,\n               240 * brightness, 100 + 100 * e);\n        beginShape();\n        for (int n = 0; n <= 160; n++) {\n            double az = n / 160.0 * Math.PI * 2;\n            double wave = Math.sin(az * 6 + theta * 9 - phase * 3) * 0.027 * e * Math.sin(theta * 2);\n            double rr = (theta / (Math.PI / 2) + wave) * radius;\n            vertex(cx + Math.cos(az + phase * 0.12) * rr,\n                   cy + Math.sin(az + phase * 0.12) * rr);\n        }\n        endShape();\n    }\n    for (int spoke = 0; spoke < 48; spoke++) {\n        double az = spoke / 48.0 * Math.PI * 2;\n        stroke((110 + 100 * e) * brightness, 45 * brightness, 220 * brightness, 135);\n        beginShape();\n        for (int j = 0; j <= 42; j++) {\n            double f = j / 42.0;\n            double bend = 0.08 * Math.sin(f * 9 - phase * 2) * e * Math.sin(f * Math.PI);\n            double a = az + phase * 0.12 + bend;\n            vertex(cx + Math.cos(a) * f * radius, cy + Math.sin(a) * f * radius);\n        }\n        endShape();\n    }\n    // Deterministic stars slide along geodesic directions; size scales with resolution.\n    noStroke();\n    for (int i = 0; i < 220; i++) {\n        double az = i * 2.399963229728653 + phase * 0.16;\n        double f = ((i * 0.61803398875 + phase * (0.02 + (i % 5) * 0.005)) % 1);\n        // Uniform sampling on a hemisphere, followed by equidistant fisheye projection.\n        double theta = Math.acos(1 - f);\n        double rr = theta / (Math.PI / 2) * radius;\n        double x = cx + Math.cos(az) * rr;\n        double y = cy + Math.sin(az) * rr;\n        double size = (1.2 + (i % 4) * 0.5 + e * 3) * width / 1024.0;\n        fill(50 * brightness, 150 * brightness, 255 * brightness, 30 + e * 30);\n        ellipse(x - size * 3, y - size * 3, size * 6, size * 6);\n        fill((160 + 90 * e) * brightness, (200 - 90 * e) * brightness, 255 * brightness, 220);\n        ellipse(x - size / 2, y - size / 2, size, size);\n    }\n    // Stable perimeter keeps the horizon defined without crossing the circular mask.\n    noFill();\n    stroke(55 * brightness, 180 * brightness, 255 * brightness, 180);\n    strokeWeight(Math.max(1, width / 700.0));\n    ellipse(cx - radius, cy - radius, radius * 2, radius * 2);\n}\n"
    .sensitivity 8
    .speed 0.35
    .brightness 0.8
  }
  @ ./output video:output { .title "Audio Reactive Dome | 180 degree fisheye" }
  ~ ./dome!out ./output!in
}
